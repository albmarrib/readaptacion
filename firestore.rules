rules_version = '2';

// Reglas de seguridad de Readaptación (ESPECIFICACION.md, sección 7).
// Roles: admin, entrenador, paciente. El rol vive en usuarios/{uid} y solo lo escribe
// el administrador o una Cloud Function; ningún cliente puede asignarse un rol.
// Centros: cada dato lleva centroId y nadie ve ni toca los de otro centro. El administrador
// lo es solo de su centro. El centroId de una persona solo lo pone una Cloud Function.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Utilidades ----------
    function yo() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function hayPerfil() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function activo()       { return hayPerfil() && yo().activo == true; }
    function miCentro()     { return yo().centroId; }
    function delCentro(d)   { return d.centroId == miCentro(); }
    function esAdmin()      { return activo() && yo().rol == 'admin'; }
    function esEntrenador() { return activo() && yo().rol == 'entrenador'; }
    function puedeCatalogo() {
      return esAdmin() || (esEntrenador() && yo().puedeEditarCatalogo == true);
    }
    function fotoValida(d) {
      return !('foto' in d) || (d.foto is string && d.foto.size() < 40000);
    }
    function pacienteDe(pid) {
      return get(/databases/$(database)/documents/pacientes/$(pid)).data;
    }
    // Admin de su centro, o entrenador dueño del paciente
    function personalDe(pid) {
      return (esAdmin() && delCentro(pacienteDe(pid)))
        || (esEntrenador() && pacienteDe(pid).entrenadorId == request.auth.uid);
    }
    // El entrenador asignado a un paciente tiene que ser del mismo centro
    function entrenadorDelCentro(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.centroId == miCentro();
    }
    function soyPaciente(pid) {
      return activo() && yo().rol == 'paciente' && yo().pacienteId == pid
        && pacienteDe(pid).estado != 'archivado';
    }

    // ---------- Usuarios ----------
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || (esAdmin() && delCentro(resource.data)));
      // Altas mediante Cloud Function. El administrador puede cambiar permisos y desactivar.
      allow update: if (esAdmin() && delCentro(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nombre', 'activo', 'puedeEditarCatalogo', 'foto'])
            && fotoValida(request.resource.data))
        // Cada persona puede cambiar su propia foto; el personal, también su nombre
        || (request.auth != null && request.auth.uid == uid && activo()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(resource.data.rol == 'paciente' ? ['foto'] : ['foto', 'nombre'])
            && fotoValida(request.resource.data)
            && request.resource.data.nombre is string
            && request.resource.data.nombre.size() > 1 && request.resource.data.nombre.size() < 121);
      allow create, delete: if false;

      // Dispositivos con avisos push (uno por móvil u ordenador); cada persona gestiona los suyos
      match /dispositivos/{did} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---------- Centros (los crea y cambia una Cloud Function) ----------
    match /centros/{cid} {
      allow read: if activo() && miCentro() == cid;
      allow write: if false;
    }

    // ---------- Catálogo (cada centro tiene el suyo) ----------
    match /gruposMusculares/{id} {
      allow read: if activo() && (resource == null || delCentro(resource.data));
      allow create: if puedeCatalogo() && delCentro(request.resource.data);
      allow update: if puedeCatalogo() && delCentro(resource.data) && delCentro(request.resource.data);
      allow delete: if puedeCatalogo() && delCentro(resource.data);
    }
    match /ejercicios/{id} {
      allow read: if activo() && (resource == null || delCentro(resource.data));
      allow create: if puedeCatalogo() && delCentro(request.resource.data);
      allow update: if puedeCatalogo() && delCentro(resource.data) && delCentro(request.resource.data);
      allow delete: if puedeCatalogo() && delCentro(resource.data);
    }
    match /sistemasEntrenamiento/{id} {
      allow read: if activo() && (resource == null || delCentro(resource.data));
      allow create: if (esAdmin() || esEntrenador()) && delCentro(request.resource.data);
      allow update: if (esAdmin() || esEntrenador()) && delCentro(resource.data) && delCentro(request.resource.data);
      allow delete: if (esAdmin() || esEntrenador()) && delCentro(resource.data);
    }
    match /volumenes/{id} {
      allow read: if activo() && (resource == null || delCentro(resource.data));
      allow create: if (esAdmin() || esEntrenador()) && delCentro(request.resource.data);
      allow update: if (esAdmin() || esEntrenador()) && delCentro(resource.data) && delCentro(request.resource.data);
      allow delete: if (esAdmin() || esEntrenador()) && delCentro(resource.data);
    }

    // ---------- Pacientes ----------
    match /pacientes/{pid} {
      allow read: if (esAdmin() && delCentro(resource.data))
        || (esEntrenador() && resource.data.entrenadorId == request.auth.uid)
        || soyPaciente(pid);
      // El consentimiento solo lo escribe el propio paciente; el personal no puede crearlo ni cambiarlo
      allow create: if (esAdmin()
        || (esEntrenador() && request.resource.data.entrenadorId == request.auth.uid))
        && delCentro(request.resource.data)
        && entrenadorDelCentro(request.resource.data.entrenadorId)
        && !('consentimiento' in request.resource.data);
      allow update: if (((esAdmin() && delCentro(resource.data) && entrenadorDelCentro(request.resource.data.entrenadorId))
            || (esEntrenador() && resource.data.entrenadorId == request.auth.uid
                && request.resource.data.entrenadorId == request.auth.uid))
          && request.resource.data.centroId == resource.data.centroId
          && request.resource.data.get('consentimiento', null) == resource.data.get('consentimiento', null))
        // El paciente solo puede registrar su aceptación, con la hora del servidor
        || (soyPaciente(pid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consentimiento'])
            && request.resource.data.consentimiento.keys().hasOnly(['fecha', 'version'])
            && request.resource.data.consentimiento.fecha == request.time
            && request.resource.data.consentimiento.version is string)
        // El paciente puede cambiar su foto
        || (soyPaciente(pid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foto'])
            && fotoValida(request.resource.data));
      allow delete: if (esAdmin() && delCentro(resource.data))
        || (esEntrenador() && resource.data.entrenadorId == request.auth.uid);

      match /rutinas/{rid} {
        // El paciente no ve los borradores
        allow read: if personalDe(pid) || (soyPaciente(pid) && resource.data.estado != 'borrador');
        allow write: if personalDe(pid);

        match /ejercicios/{eid} {
          allow read: if personalDe(pid)
            || (soyPaciente(pid)
                && get(/databases/$(database)/documents/pacientes/$(pid)/rutinas/$(rid)).data.estado != 'borrador');
          allow create, delete: if personalDe(pid);
          // El paciente solo puede modificar los pesos, y solo en una rutina activa
          allow update: if personalDe(pid)
            || (soyPaciente(pid)
                && get(/databases/$(database)/documents/pacientes/$(pid)/rutinas/$(rid)).data.estado == 'activa'
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['pesos', 'pesosActualizado']));
        }
        match /notas/{nid} {
          allow read, write: if personalDe(pid);
        }

        // Entrenamientos hechos por el paciente (una sesión por día de entreno y fecha).
        // Solo el paciente la escribe, solo en una rutina activa y solo con estos campos.
        match /sesiones/{sid} {
          allow read: if personalDe(pid) || soyPaciente(pid);
          allow create, update: if soyPaciente(pid)
            && get(/databases/$(database)/documents/pacientes/$(pid)/rutinas/$(rid)).data.estado == 'activa'
            && request.resource.data.keys().hasOnly(['dia', 'fecha', 'hechos', 'completada', 'actualizado'])
            && request.resource.data.dia is int
            && request.resource.data.fecha is string && request.resource.data.fecha.size() == 10
            && request.resource.data.hechos is map
            && request.resource.data.completada is bool;
          allow delete: if personalDe(pid);
        }
      }

      // Chat entre el paciente y su entrenador. Los mensajes no se editan ni se borran.
      match /mensajes/{mid} {
        allow read: if personalDe(pid) || soyPaciente(pid);
        allow create: if request.resource.data.keys().hasOnly(['autorId', 'autorRol', 'texto', 'fecha'])
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000
          && request.resource.data.fecha == request.time
          && ((request.resource.data.autorRol == 'personal' && personalDe(pid))
              || (request.resource.data.autorRol == 'paciente' && soyPaciente(pid)));
        allow update, delete: if false;
      }
    }

    // ---------- Resumen del chat (lo mantiene una Cloud Function) ----------
    // Cada lado solo puede poner a cero sus propios no leídos.
    match /chats/{pid} {
      allow read: if (esAdmin() && delCentro(resource.data))
        || ((esAdmin() || esEntrenador()) && resource.data.entrenadorId == request.auth.uid)
        || soyPaciente(pid);
      allow update: if (personalDe(pid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noLeidosEntrenador'])
            && request.resource.data.noLeidosEntrenador == 0)
        || (soyPaciente(pid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noLeidosPaciente'])
            && request.resource.data.noLeidosPaciente == 0);
      allow create, delete: if false;
    }

    // ---------- Avisos (los crea una Cloud Function) ----------
    match /avisos/{id} {
      allow read: if (esAdmin() && delCentro(resource.data)) || ((esAdmin() || esEntrenador()) && resource.data.entrenadorId == request.auth.uid);
      allow update: if ((esAdmin() && delCentro(resource.data)) || ((esAdmin() || esEntrenador()) && resource.data.entrenadorId == request.auth.uid))
        && request.resource.data.centroId == resource.data.centroId;
      allow create, delete: if false;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
