# Copia este archivo como .env y rellena los valores de la app web de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=readaptacion-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=readaptacion-app
VITE_FIREBASE_STORAGE_BUCKET=readaptacion-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
